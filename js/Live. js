// MatchIA - LIVE
// Datos en vivo del partido.
// NO modifica las calibraciones de porcentajes.

(function () {
  "use strict";

  let liveTimer = null;
  let currentLiveId = null;

  function setText(id, value) {
    const element = document.getElementById(id);

    if (element) {
      element.textContent = value == null ? "" : value;
    }
  }

  function setImage(id, src) {
    const element = document.getElementById(id);

    if (!element) return;

    if (src) {
      element.src = src;
      element.style.display = "block";
    }
  }

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function numero(value) {
    const n = Number(value);

    return Number.isFinite(n) ? n : 0;
  }

  function buscarStat(stats, nombres) {
    for (const nombre of nombres) {
      const encontrado = stats.find(function (item) {
        return String(item.tipo || "")
          .toLowerCase()
          .trim() === nombre.toLowerCase();
      });

      if (encontrado) {
        return encontrado.valor;
      }
    }

    return "-";
  }

  function convertirNumeroStat(value) {
    if (value === null || value === undefined) {
      return 0;
    }

    const texto = String(value)
      .replace("%", "")
      .replace(",", ".")
      .trim();

    const n = Number(texto);

    return Number.isFinite(n) ? n : 0;
  }

  function obtenerEquipoStats(datos, index) {
    return datos.estadisticas &&
      datos.estadisticas[index]
      ? datos.estadisticas[index].estadisticas || []
      : [];
  }

  function renderLiveStats(datos) {
    const container =
      document.getElementById("liveStats");

    if (!container) return;

    const homeStats =
      obtenerEquipoStats(datos, 0);

    const awayStats =
      obtenerEquipoStats(datos, 1);

    const filas = [
      {
        nombre: "Tiros",
        home: buscarStat(homeStats, [
          "Total Shots"
        ]),
        away: buscarStat(awayStats, [
          "Total Shots"
        ])
      },
      {
        nombre: "Tiros al arco",
        home: buscarStat(homeStats, [
          "Shots on Goal"
        ]),
        away: buscarStat(awayStats, [
          "Shots on Goal"
        ])
      },
      {
        nombre: "Posesión",
        home: buscarStat(homeStats, [
          "Ball Possession"
        ]),
        away: buscarStat(awayStats, [
          "Ball Possession"
        ])
      },
      {
        nombre: "Corners",
        home: buscarStat(homeStats, [
          "Corner Kicks"
        ]),
        away: buscarStat(awayStats, [
          "Corner Kicks"
        ])
      },
      {
        nombre: "Faltas",
        home: buscarStat(homeStats, [
          "Fouls"
        ]),
        away: buscarStat(awayStats, [
          "Fouls"
        ])
      },
      {
        nombre: "Tarjetas amarillas",
        home: buscarStat(homeStats, [
          "Yellow Cards"
        ]),
        away: buscarStat(awayStats, [
          "Yellow Cards"
        ])
      },
      {
        nombre: "Tarjetas rojas",
        home: buscarStat(homeStats, [
          "Red Cards"
        ]),
        away: buscarStat(awayStats, [
          "Red Cards"
        ])
      }
    ];

    container.innerHTML = filas
      .map(function (fila) {
        return `
          <div class="live-stat-row">
            <div class="live-stat-value live-stat-home">
              ${escapeHtml(fila.home)}
            </div>

            <div class="live-stat-name">
              ${escapeHtml(fila.nombre)}
            </div>

            <div class="live-stat-value live-stat-away">
              ${escapeHtml(fila.away)}
            </div>
          </div>
        `;
      })
      .join("");
  }

  function obtenerValoresParaMotor(datos) {
    const homeStats =
      obtenerEquipoStats(datos, 0);

    const awayStats =
      obtenerEquipoStats(datos, 1);

    const cornersHome =
      convertirNumeroStat(
        buscarStat(homeStats, ["Corner Kicks"])
      );

    const cornersAway =
      convertirNumeroStat(
        buscarStat(awayStats, ["Corner Kicks"])
      );

    const shotsHome =
      convertirNumeroStat(
        buscarStat(homeStats, ["Total Shots"])
      );

    const shotsAway =
      convertirNumeroStat(
        buscarStat(awayStats, ["Total Shots"])
      );

    const shotsOnTargetHome =
      convertirNumeroStat(
        buscarStat(homeStats, ["Shots on Goal"])
      );

    const shotsOnTargetAway =
      convertirNumeroStat(
        buscarStat(awayStats, ["Shots on Goal"])
      );

    const redHome =
      convertirNumeroStat(
        buscarStat(homeStats, ["Red Cards"])
      );

    const redAway =
      convertirNumeroStat(
        buscarStat(awayStats, ["Red Cards"])
      );

    return {
      minute: numero(datos.minuto),

      goalsHome:
        numero(datos.marcador?.local),

      goalsAway:
        numero(datos.marcador?.visitante),

      cornersHome,
      cornersAway,

      shotsHome,
      shotsAway,

      shotsOnTargetHome,
      shotsOnTargetAway,

      redHome,
      redAway
    };
  }

  function actualizarProbabilidades(datos) {
    /*
     * IMPORTANTE:
     * Usamos el motor existente de calibraciones.
     * No se cambian sus fórmulas ni pesos.
     */

    if (
      !window.MatchIA ||
      typeof window.MatchIA.calculateProbabilities !==
        "function"
    ) {
      return;
    }

    const valores =
      obtenerValoresParaMotor(datos);

    const match = {
      minute: valores.minute,
      goalsHome: valores.goalsHome,
      goalsAway: valores.goalsAway,
      arrivalsHome: 0,
      arrivalsAway: 0,
      shotsHome: valores.shotsHome,
      shotsAway: valores.shotsAway,
      shotsOnTargetHome:
        valores.shotsOnTargetHome,
      shotsOnTargetAway:
        valores.shotsOnTargetAway,
      cornersHome: valores.cornersHome,
      cornersAway: valores.cornersAway,
      redsHome: valores.redHome,
      redsAway: valores.redAway
    };

    try {
      const resultado =
        window.MatchIA.calculateProbabilities(
          match
        );

      if (!resultado) return;

      const home =
        resultado.home ??
        resultado.local ??
        resultado.homeWin;

      const draw =
        resultado.draw ??
        resultado.empate;

      const away =
        resultado.away ??
        resultado.visitante ??
        resultado.awayWin;

      if (home !== undefined) {
        setText(
          "liveProbHome",
          formatPercent(home)
        );
      }

      if (draw !== undefined) {
        setText(
          "liveProbDraw",
          formatPercent(draw)
        );
      }

      if (away !== undefined) {
        setText(
          "liveProbAway",
          formatPercent(away)
        );
      }

    } catch (error) {
      console.warn(
        "No se pudieron actualizar probabilidades:",
        error
      );
    }
  }

  function renderLiveAnalysis(datos) {
    const container =
      document.getElementById("liveAnalysis");

    if (!container) return;

    let texto =
      "Análisis en vivo basado en el desarrollo actual del partido.";

    if (
      window.MatchIA &&
      typeof window.MatchIA.generateAnalysis ===
        "function"
    ) {
      try {
        const valores =
          obtenerValoresParaMotor(datos);

        const match = {
          minute: valores.minute,
          goalsHome: valores.goalsHome,
          goalsAway: valores.goalsAway,
          arrivalsHome: 0,
          arrivalsAway: 0,
          shotsHome: valores.shotsHome,
          shotsAway: valores.shotsAway,
          shotsOnTargetHome:
            valores.shotsOnTargetHome,
          shotsOnTargetAway:
            valores.shotsOnTargetAway,
          cornersHome: valores.cornersHome,
          cornersAway: valores.cornersAway,
          redsHome: valores.redHome,
          redsAway: valores.redAway
        };

        const resultado =
          window.MatchIA.generateAnalysis(match);

        if (typeof resultado === "string") {
          texto = resultado;
        } else if (resultado?.text) {
          texto = resultado.text;
        } else if (resultado?.analysis) {
          texto = resultado.analysis;
        }
      } catch (error) {
        console.warn(
          "Error generando análisis:",
          error
        );
      }
    }

    container.textContent = texto;
  }

  const pitchPreviousStats = Object.create(null);

  function actualizarCancha5D(datos) {
    const local = datos.local || {};
    const visitante = datos.visitante || {};
    const homeStats = obtenerEquipoStats(datos, 0);
    const awayStats = obtenerEquipoStats(datos, 1);
    const homeSot = convertirNumeroStat(buscarStat(homeStats, ["Shots on Goal"]));
    const awaySot = convertirNumeroStat(buscarStat(awayStats, ["Shots on Goal"]));
    const homeCorners = convertirNumeroStat(buscarStat(homeStats, ["Corner Kicks"]));
    const awayCorners = convertirNumeroStat(buscarStat(awayStats, ["Corner Kicks"]));
    const homeShots = convertirNumeroStat(buscarStat(homeStats, ["Total Shots"]));
    const awayShots = convertirNumeroStat(buscarStat(awayStats, ["Total Shots"]));
    const homeGoalKicks = convertirNumeroStat(buscarStat(homeStats, ["Goal Kicks"]));
    const awayGoalKicks = convertirNumeroStat(buscarStat(awayStats, ["Goal Kicks"]));
    const ball = document.getElementById("ball5d");
    const trail = document.querySelector(".ball-trail");
    const pitch = document.querySelector(".pitch5d");
    const status = document.getElementById("pitchStatus");
    const fixtureId = String(datos.id || currentLiveId || "partido");
    const previous = pitchPreviousStats[fixtureId];
    let eventState = "";
    let eventTeam = "";
    let eventSide = "";

    // Los aumentos de córners/saques de arco se detectan entre actualizaciones.
    // No se inventan eventos cuando la API no entrega esa estadística.
    if (previous) {
      if (homeCorners > previous.homeCorners) {
        eventState = "corner";
        eventTeam = local.nombre || "LOCAL";
        eventSide = "home";
      } else if (awayCorners > previous.awayCorners) {
        eventState = "corner";
        eventTeam = visitante.nombre || "VISITANTE";
        eventSide = "away";
      } else if (homeGoalKicks > previous.homeGoalKicks) {
        eventState = "goal-kick";
        eventTeam = local.nombre || "LOCAL";
        eventSide = "home";
      } else if (awayGoalKicks > previous.awayGoalKicks) {
        eventState = "goal-kick";
        eventTeam = visitante.nombre || "VISITANTE";
        eventSide = "away";
      }
    }

    pitchPreviousStats[fixtureId] = {
      homeCorners, awayCorners, homeGoalKicks, awayGoalKicks
    };

    // Posición estimada por presión estadística, no seguimiento GPS de la pelota.
    const homePressure = homeSot * 2 + homeCorners + homeShots * 0.25;
    const awayPressure = awaySot * 2 + awayCorners + awayShots * 0.25;
    const total = homePressure + awayPressure;
    const homeShare = total > 0 ? homePressure / total : 0.5;
    const dangerHome = homeShare > 0.7;
    const dangerAway = homeShare < 0.3;
    let x = Math.max(18, Math.min(82, 18 + homeShare * 64));
    let y = homeShare >= 0.58 ? 34 : homeShare <= 0.42 ? 66 : 50;
    let color = dangerHome || dangerAway ? "#ff5b45"
      : homeShare > 0.55 ? "#b8ff00"
      : homeShare < 0.45 ? "#42e8ff" : "#ffffff";
    let glow = dangerHome || dangerAway
      ? "0 0 14px #ff5b45,0 0 30px rgba(255,91,69,.8)"
      : homeShare > 0.55
        ? "0 0 12px #b8ff00,0 0 25px rgba(184,255,0,.7)"
        : homeShare < 0.45
          ? "0 0 12px #42e8ff,0 0 25px rgba(66,232,255,.7)"
          : "0 0 12px #fff,0 0 25px #42e8ff";

    if (dangerHome) x = 84;
    if (dangerAway) x = 16;

    if (eventState === "corner") {
      x = eventSide === "home" ? 91 : 9;
      y = homeShare > 0.5 ? 8 : 92;
      color = "#ffb000";
      glow = "0 0 14px #ffb000,0 0 30px rgba(255,176,0,.8)";
    } else if (eventState === "goal-kick") {
      x = eventSide === "home" ? 8 : 92;
      y = 50;
      color = "#42e8ff";
      glow = "0 0 14px #42e8ff,0 0 30px rgba(66,232,255,.8)";
    }

    if (ball) {
      ball.style.left = x + "%";
      ball.style.top = y + "%";
      ball.style.background = color;
      ball.style.boxShadow = glow;
      ball.dataset.state = eventState || (dangerHome || dangerAway ? "danger" : "play");
    }
    if (trail) {
      trail.style.left = Math.max(4, Math.min(86, x - 8)) + "%";
      trail.style.top = (y + 2) + "%";
      trail.style.transform = eventState === "corner" ? "rotate(0deg)"
        : eventState === "goal-kick" ? "rotate(180deg)"
        : homeShare < 0.45 ? "rotate(12deg)" : "rotate(-12deg)";
      trail.style.background = "linear-gradient(90deg,transparent," + color + ")";
      trail.style.opacity = "0.85";
    }
    if (pitch) {
      pitch.dataset.pressure = dangerHome ? "ataque-local"
        : dangerAway ? "ataque-visitante"
        : homeShare > 0.55 ? "local"
        : homeShare < 0.45 ? "visitante" : "equilibrada";
      pitch.dataset.event = eventState || "none";
    }
    if (status) {
      if (eventState === "corner") {
        status.textContent = "⚑ TIRO DE ESQUINA · " + eventTeam;
      } else if (eventState === "goal-kick") {
        status.textContent = "🥅 SAQUE DE ARCO · " + eventTeam;
      } else if (dangerHome) {
        status.textContent = "ATAQUE PELIGROSO · " + (local.nombre || "LOCAL");
      } else if (dangerAway) {
        status.textContent = "ATAQUE PELIGROSO · " + (visitante.nombre || "VISITANTE");
      } else if (homeShare > 0.55) {
        status.textContent = "ATACA · " + (local.nombre || "LOCAL");
      } else if (homeShare < 0.45) {
        status.textContent = "ATACA · " + (visitante.nombre || "VISITANTE");
      } else {
        status.textContent = "POSESIÓN DISPUTADA";
      }
    }
  }
  function renderLiveMatch(datos) {
    const local = datos.local || {};
    const visitante = datos.visitante || {};

    setText(
      "liveHomeName",
      local.nombre || "Local"
    );

    setText(
      "liveAwayName",
      visitante.nombre || "Visitante"
    );

    setImage(
      "liveHomeLogo",
      local.logo
    );

    setImage(
      "liveAwayLogo",
      visitante.logo
    );

    setText(
      "liveHomeScore",
      datos.marcador?.local ?? 0
    );

    setText(
      "liveAwayScore",
      datos.marcador?.visitante ?? 0
    );

    setText(
      "liveMinute",
      datos.minuto
        ? `${datos.minuto}'`
        : "EN VIVO"
    );

    setText(
      "liveLeague",
      datos.liga?.nombre || "Liga"
    );

    renderLiveStats(datos);

    actualizarProbabilidades(datos);

    renderLiveAnalysis(datos);
    actualizarCancha5D(datos);

    // Sincronizar también la pantalla holográfica 5D.
    setText("pitchHomeName", local.nombre || "LOCAL");
    setText("pitchAwayName", visitante.nombre || "VISITANTE");
    setText("pitchHomeScore", datos.marcador?.local ?? 0);
    setText("pitchAwayScore", datos.marcador?.visitante ?? 0);
    setText(
      "pitch5dMinute",
      datos.minuto ? `${datos.minuto}'` : (datos.estado || "PREVIA")
    );

    const homeStats = obtenerEquipoStats(datos, 0);
    const awayStats = obtenerEquipoStats(datos, 1);
    const possessionHome = buscarStat(homeStats, ["Ball Possession"]);
    const possessionAway = buscarStat(awayStats, ["Ball Possession"]);
    const shotsHome = buscarStat(homeStats, ["Total Shots"]);
    const shotsAway = buscarStat(awayStats, ["Total Shots"]);
    const cornersHome = buscarStat(homeStats, ["Corner Kicks"]);
    const cornersAway = buscarStat(awayStats, ["Corner Kicks"]);
    const sotHome = buscarStat(homeStats, ["Shots on Goal"]);
    const sotAway = buscarStat(awayStats, ["Shots on Goal"]);

    setText("pitchPossession", `${possessionHome ?? "--"} / ${possessionAway ?? "--"}`);
    setText("pitchShots", `${shotsHome ?? "--"} / ${shotsAway ?? "--"}`);
    setText("pitchCorners", `${cornersHome ?? "--"} / ${cornersAway ?? "--"}`);
    setText("pitchPressure", `${sotHome ?? "--"} / ${sotAway ?? "--"}`);

    const homeProb = document.getElementById("liveProbHome")?.textContent || "--%";
    const drawProb = document.getElementById("liveProbDraw")?.textContent || "--%";
    const awayProb = document.getElementById("liveProbAway")?.textContent || "--%";
    setText("pitchProbHome", homeProb);
    setText("pitchProbDraw", drawProb);
    setText("pitchProbAway", awayProb);
  }

  async function loadLiveMatch(fixtureId) {
    if (!fixtureId) return;

    currentLiveId = fixtureId;

    if (liveTimer) {
      clearInterval(liveTimer);
      liveTimer = null;
    }

    await actualizarPartidoEnVivo();

    /*
     * API-Football se consulta periódicamente.
     * Cada 30 segundos actualizamos el partido.
     */
    liveTimer = setInterval(
      actualizarPartidoEnVivo,
      30000
    );
  }

  async function actualizarPartidoEnVivo() {
    if (!currentLiveId) return;

    try {
      const response = await fetch(
        `/api/match?id=${encodeURIComponent(
          currentLiveId
        )}`,
        {
          cache: "no-store"
        }
      );

      if (!response.ok) {
        throw new Error(
          "Error API: " + response.status
        );
      }

      const datos =
        await response.json();

      window.MatchIALiveData = datos;

      renderLiveMatch(datos);

      /*
       * Si terminó el partido dejamos de consultar
       * como partido en vivo.
       */
      const estado =
        String(datos.estado || "")
          .toUpperCase();

      if (
        ["FT", "AET", "PEN"].includes(estado)
      ) {
        detenerLive();
      }

    } catch (error) {
      console.error(
        "MatchIA - Error actualizando partido en vivo:",
        error
      );

      const analysis =
        document.getElementById(
          "liveAnalysis"
        );

      if (analysis) {
        analysis.textContent =
          "Esperando actualización de datos...";
      }
    }
  }

  function detenerLive() {
    if (liveTimer) {
      clearInterval(liveTimer);
      liveTimer = null;
    }

    currentLiveId = null;
  }

  window.loadLiveMatch =
    loadLiveMatch;

  window.refreshLiveMatch =
    actualizarPartidoEnVivo;

  window.stopLiveMatch =
    detenerLive;

  window.MatchIALive = {
    load: loadLiveMatch,
    refresh: actualizarPartidoEnVivo,
    stop: detenerLive
  };

  function formatPercent(value) {
    let number = Number(value);

    if (!Number.isFinite(number)) {
      return "--%";
    }

    if (number <= 1) {
      number *= 100;
    }

    return Math.round(number) + "%";
  }

})();
