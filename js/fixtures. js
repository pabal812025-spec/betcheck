// MatchIA - FIXTURES
// Partidos reales desde API-Football.
// NO modifica las calibraciones de porcentajes.

(function () {
  "use strict";

  let fixturesCache = [];
  let selectedDate = null;

  // El selector siempre ofrece cinco días hacia atrás y cinco hacia adelante.
  // Los límites se calculan desde la fecha actual de Argentina para que no caduquen.
  function getMinDate() {
    return getArgentinaDate(-5);
  }

  function getMaxDate() {
    return getArgentinaDate(5);
  }

  function getArgentinaDate(offsetDays) {
    const now = new Date();

    const argentina = new Intl.DateTimeFormat("en-CA", {
      timeZone: "America/Argentina/Buenos_Aires",
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }).format(now);

    const date = new Date(argentina + "T12:00:00");

    date.setDate(date.getDate() + (offsetDays || 0));

    return [
      date.getFullYear(),
      String(date.getMonth() + 1).padStart(2, "0"),
      String(date.getDate()).padStart(2, "0")
    ].join("-");
  }

  function getToday() {
    return getArgentinaDate(0);
  }

  function isValidDate(value) {
    return /^\d{4}-\d{2}-\d{2}$/.test(value);
  }

  function clampDate(value) {
    if (!isValidDate(value)) {
      return getToday();
    }

    const minDate = getMinDate();
    const maxDate = getMaxDate();

    if (value < minDate) {
      return minDate;
    }

    if (value > maxDate) {
      return maxDate;
    }

    return value;
  }

  function formatDateTitle(dateString) {
    if (!dateString) return "";

    const date = new Date(dateString + "T12:00:00");

    if (Number.isNaN(date.getTime())) {
      return "";
    }

    return new Intl.DateTimeFormat("es-AR", {
      day: "numeric",
      month: "long"
    })
      .format(date)
      .toUpperCase();
  }

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function formatTime(value) {
    if (!value) return "--:--";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "--:--";
    }

    return date.toLocaleTimeString("es-AR", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false
    });
  }

  function isLive(partido) {
    return [
      "1H",
      "HT",
      "2H",
      "ET",
      "BT",
      "P",
      "LIVE"
    ].includes(partido.estado);
  }

  function isFinished(partido) {
    return [
      "FT",
      "AET",
      "PEN"
    ].includes(partido.estado);
  }

  function isUpcoming(partido) {
    return !isLive(partido) && !isFinished(partido);
  }

  function renderTeamLogo(logo, name) {
    if (logo) {
      return `
        <img
          class="team-logo"
          src="${escapeHtml(logo)}"
          alt="${escapeHtml(name)}"
          loading="lazy"
        >
      `;
    }

    return `<div class="team-logo-placeholder">⚽</div>`;
  }

  function renderMatchCard(partido) {
    const live = isLive(partido);
    const finished = isFinished(partido);
    const upcoming = isUpcoming(partido);

    let centro;

    if (live) {
      centro = `
        <div class="match-score">
          <strong>
            ${partido.golesLocal ?? 0} - ${partido.golesVisitante ?? 0}
          </strong>
          <small class="live-label">
            ${partido.minuto || 0}'
          </small>
        </div>
      `;
    } else if (finished) {
      centro = `
        <div class="match-score">
          <strong>
            ${partido.golesLocal ?? 0} - ${partido.golesVisitante ?? 0}
          </strong>
          <small>RESULTADO</small>
        </div>
      `;
    } else {
      centro = `
        <div class="match-score">
          <strong>${formatTime(partido.fecha)}</strong>
          <small>VS</small>
        </div>
      `;
    }

    const clase =
      live
        ? "match-card live-card"
        : finished
          ? "match-card finished-card"
          : "match-card upcoming-card";

    return `
      <article
        class="${clase} matchia-fixture-card"
        onclick="openMatch(${Number(partido.id)}, ${live})"
        data-fixture-id="${Number(partido.id)}"
        role="button"
        tabindex="0"
        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openMatch(${Number(partido.id)}, ${live})}"
      >
        <div class="matchia-fixture-head">
          <span class="matchia-fixture-league">${escapeHtml(partido.liga || "Liga")}</span>
          <span class="matchia-fixture-live">${live ? "● EN VIVO" : upcoming ? "IA 5D" : "RESULTADO"}</span>
        </div>

        <div class="matchia-fixture-body">
          <div class="matchia-team5d">
            ${renderTeamLogo(partido.logoLocal, partido.local)}
            <span>${escapeHtml(partido.local)}</span>
          </div>

          <div class="matchia-fixture-center">
            ${live ? `
              <strong class="matchia-score5d">${partido.golesLocal ?? 0} - ${partido.golesVisitante ?? 0}</strong>
              <small class="matchia-fixture-time">${partido.minuto || 0}'</small>
            ` : finished ? `
              <strong class="matchia-score5d">${partido.golesLocal ?? 0} - ${partido.golesVisitante ?? 0}</strong>
              <small class="matchia-fixture-time">RESULTADO</small>
            ` : `
              <strong class="matchia-fixture-time">${formatTime(partido.fecha)}</strong>
              <small class="matchia-fixture-vs">VS</small>
            `}
          </div>

          <div class="matchia-team5d">
            ${renderTeamLogo(partido.logoVisitante, partido.visitante)}
            <span>${escapeHtml(partido.visitante)}</span>
          </div>
        </div>

        <div class="matchia-card-footer">
          <span class="matchia-ai">${live ? "ANÁLISIS EN VIVO" : upcoming ? "PREDICCIÓN IA" : "ANÁLISIS DEL PARTIDO"}</span>
          <span class="matchia-card-arrow">›</span>
        </div>
      </article>
    `;
  }

  function groupByLeague(partidos) {
    const grupos = {};

    partidos.forEach(function (partido) {
      const liga = partido.liga || "OTRAS COMPETICIONES";

      if (!grupos[liga]) {
        grupos[liga] = [];
      }

      grupos[liga].push(partido);
    });

    return grupos;
  }

  function renderLeagueGroups(partidos, container) {
    if (!container) return;

    if (!partidos.length) {
      container.innerHTML = `
        <div class="empty-card">
          No hay partidos para esta fecha.
        </div>
      `;
      return;
    }

    const grupos = groupByLeague(partidos);

    const html = Object.keys(grupos)
      .sort(function (a, b) {
        return a.localeCompare(b, "es");
      })
      .map(function (liga) {
        return `
          <section class="league-group">

            <div class="league-title">
              <span>${escapeHtml(liga)}</span>
            </div>

            <div class="league-matches">
              ${grupos[liga]
                .map(function (partido) {
                  return renderMatchCard(partido);
                })
                .join("")}
            </div>

          </section>
        `;
      })
      .join("");

    container.innerHTML = html;
  }

  function renderHomeForSelectedDate(partidos) {
    const today = getToday();

    const isToday = selectedDate === today;
    const isPast = selectedDate < today;
    const isFuture = selectedDate > today;

    const live = partidos.filter(isLive);
    const finished = partidos.filter(isFinished);
    const upcoming = partidos.filter(isUpcoming);

    const liveContainer =
      document.getElementById("livePreview");

    const upcomingContainer =
      document.getElementById("upcomingMatches");

    const finishedContainer =
      document.getElementById("finishedPreview");

    /*
     * FUTURO
     * Solo próximos.
     */
    if (isFuture) {

      if (liveContainer) {
        liveContainer.innerHTML = "";
      }

      if (finishedContainer) {
        finishedContainer.innerHTML = "";
      }

      if (upcomingContainer) {
        renderLeagueGroups(
          upcoming,
          upcomingContainer
        );
      }

      return;
    }

    /*
     * PASADO
     * Solo terminados.
     */
    if (isPast) {

      if (liveContainer) {
        liveContainer.innerHTML = "";
      }

      if (upcomingContainer) {
        upcomingContainer.innerHTML = "";
      }

      if (finishedContainer) {
        renderLeagueGroups(
          finished,
          finishedContainer
        );
      }

      return;
    }

    /*
     * HOY
     * En vivo + próximos + terminados.
     */

    if (liveContainer) {
      if (live.length) {
        renderLeagueGroups(
          live,
          liveContainer
        );
      } else {
        liveContainer.innerHTML = `
          <div class="empty-card">
            No hay partidos en vivo en este momento.
          </div>
        `;
      }
    }

    if (upcomingContainer) {
      if (upcoming.length) {
        renderLeagueGroups(
          upcoming,
          upcomingContainer
        );
      } else {
        upcomingContainer.innerHTML = `
          <div class="empty-card">
            No hay próximos partidos.
          </div>
        `;
      }
    }

    if (finishedContainer) {
      if (finished.length) {
        renderLeagueGroups(
          finished,
          finishedContainer
        );
      } else {
        finishedContainer.innerHTML = `
          <div class="empty-card">
            Todavía no hay partidos terminados.
          </div>
        `;
      }
    }
  }

  function renderFeatured(partidos) {
    const container =
      document.getElementById("featuredMatch");

    if (!container) return;

    /*
     * La pantalla principal ya no mostrará
     * un análisis o porcentaje destacado.
     *
     * Dejamos el contenedor vacío para que
     * los partidos ocupen ese espacio.
     */

    container.innerHTML = "";
  }

  window.renderFinishedMatches = function () {
    const container =
      document.getElementById("finishedMatches");

    if (!container) return;

    const today = getToday();

    const finished = fixturesCache.filter(function (partido) {
      return isFinished(partido);
    });

    /*
     * La pantalla "Finalizados" solo muestra
     * partidos terminados.
     */
    if (!finished.length) {
      container.innerHTML = `
        <div class="empty-card">
          No hay partidos finalizados para esta fecha.
        </div>
      `;
      return;
    }

    renderLeagueGroups(
      finished,
      container
    );
  };

  function updateDateSelector() {
    const dateElement =
      document.getElementById("selectedDate");

    if (dateElement) {
      dateElement.textContent =
        formatDateTitle(selectedDate);
    }

    const previous =
      document.getElementById("previousDate");

    const next =
      document.getElementById("nextDate");

    if (previous) {
      previous.disabled =
        selectedDate <= getMinDate();
    }

    if (next) {
      next.disabled =
        selectedDate >= getMaxDate();
    }
  }

  window.setMatchIADate = function (dateString) {
    selectedDate = clampDate(dateString);

    updateDateSelector();

    loadFixtures(true, selectedDate);
  };

  window.changeMatchIADate = function (days) {
    if (!selectedDate) {
      selectedDate = getToday();
    }

    const date =
      new Date(selectedDate + "T12:00:00");

    date.setDate(
      date.getDate() + Number(days || 0)
    );

    const nuevaFecha = [
      date.getFullYear(),
      String(date.getMonth() + 1).padStart(2, "0"),
      String(date.getDate()).padStart(2, "0")
    ].join("-");

    if (
      nuevaFecha < getMinDate() ||
      nuevaFecha > getMaxDate()
    ) {
      return;
    }

    selectedDate = nuevaFecha;

    updateDateSelector();

    loadFixtures(true, selectedDate);
  };

  window.getSelectedMatchIADate = function () {
    return selectedDate;
  };

  async function loadFixtures(forceRefresh, dateChoice) {

    selectedDate =
      clampDate(
        dateChoice ||
        selectedDate ||
        getToday()
      );

    updateDateSelector();

    const loadingElements =
      document.querySelectorAll(
        ".loading-fixtures"
      );

    loadingElements.forEach(function (element) {
      element.style.display = "block";
    });

    try {

      const response = await fetch(
        `/api/fixtures?date=${encodeURIComponent(selectedDate)}`,
        {
          cache: forceRefresh
            ? "no-store"
            : "default"
        }
      );

      if (!response.ok) {
        throw new Error(
          "API de fixtures respondió con estado " +
          response.status
        );
      }

      const data =
        await response.json();

      fixturesCache =
        Array.isArray(data.partidos)
          ? data.partidos
          : [];

      window.MatchIAFixtures =
        fixturesCache;

      renderFeatured(
        fixturesCache
      );

      renderHomeForSelectedDate(
        fixturesCache
      );

      if (
        window.MatchIAUI &&
        typeof window.MatchIAUI.getCurrentScreen ===
          "function" &&
        window.MatchIAUI.getCurrentScreen() ===
          "finished"
      ) {
        window.renderFinishedMatches();
      }

      console.log(
        "MatchIA: partidos cargados:",
        fixturesCache.length,
        "fecha:",
        selectedDate
      );

    } catch (error) {

      console.error(
        "MatchIA - Error cargando fixtures:",
        error
      );

      fixturesCache = [];

      const containers = [
        "featuredMatch",
        "upcomingMatches",
        "livePreview",
        "finishedPreview",
        "finishedMatches"
      ];

      containers.forEach(function (id) {

        const element =
          document.getElementById(id);

        if (element) {

          element.innerHTML = `
            <div class="empty-card">
              No se pudieron cargar los partidos.
              <br>
              <small>
                Revisá la conexión con la API.
              </small>
            </div>
          `;

        }

      });

    } finally {

      loadingElements.forEach(function (element) {
        element.style.display = "none";
      });

    }
  }

  window.loadFixtures =
    loadFixtures;

  window.getFixtures =
    function () {
      return fixturesCache;
    };

  window.doSearch =
    function () {

      const input =
        document.getElementById(
          "searchInput"
        );

      const container =
        document.getElementById(
          "searchResults"
        );

      if (!input || !container) return;

      const texto =
        input.value
          .trim()
          .toLowerCase();

      if (!texto) {

        container.innerHTML = `
          <div class="empty-card">
            Escribí un equipo para buscar.
          </div>
        `;

        return;
      }

      const resultados =
        fixturesCache.filter(
          function (partido) {

            const local =
              String(partido.local || "")
                .toLowerCase();

            const visitante =
              String(partido.visitante || "")
                .toLowerCase();

            const liga =
              String(partido.liga || "")
                .toLowerCase();

            return (
              local.includes(texto) ||
              visitante.includes(texto) ||
              liga.includes(texto)
            );
          }
        );

      if (!resultados.length) {

        container.innerHTML = `
          <div class="empty-card">
            No encontramos partidos para
            "${escapeHtml(input.value)}".
          </div>
        `;

        return;
      }

      renderLeagueGroups(
        resultados,
        container
      );
    };

  window.refreshFixtures =
    function () {
      loadFixtures(
        true,
        selectedDate
      );
    };

  document.addEventListener(
    "DOMContentLoaded",
    function () {

      selectedDate = getToday();

      updateDateSelector();

      const searchInput =
        document.getElementById(
          "searchInput"
        );

      if (searchInput) {

        searchInput.addEventListener(
          "input",
          function () {
            window.doSearch();
          }
        );

      }

      /*
       * Actualización automática.
       *
       * En vivo: cada 60 segundos.
       * En otras fechas: también mantenemos
       * la información actualizada.
       */

      setInterval(
        function () {

          if (
            document.visibilityState ===
            "visible"
          ) {

            loadFixtures(
              true,
              selectedDate
            );

          }

        },
        60000
      );

    }
  );

})();
