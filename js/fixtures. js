// MatchIA - FIXTURES
// Partidos reales desde API-Football.
// NO modifica las calibraciones de porcentajes.

(function () {
  "use strict";

  let fixturesCache = [];
  let selectedDate = "today";

  function getArgentinaDate(offsetDays) {
    const now = new Date();

    const argentina = new Intl.DateTimeFormat("en-CA", {
      timeZone: "America/Argentina/Buenos_Aires",
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }).format(now);

    const date = new Date(argentina + "T12:00:00");

    date.setDate(date.getDate() + (offsetDays || 0));

    return [
      date.getFullYear(),
      String(date.getMonth() + 1).padStart(2, "0"),
      String(date.getDate()).padStart(2, "0")
    ].join("-");
  }

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function formatTime(value) {
    if (!value) return "--:--";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "--:--";
    }

    return date.toLocaleTimeString("es-AR", {
      hour: "2-digit",
      minute: "2-digit"
    });
  }

  function isLive(partido) {
    return [
      "1H",
      "HT",
      "2H",
      "ET",
      "BT",
      "P",
      "LIVE"
    ].includes(partido.estado);
  }

  function isFinished(partido) {
    return [
      "FT",
      "AET",
      "PEN"
    ].includes(partido.estado);
  }

  function renderTeamLogo(logo, name) {
    if (logo) {
      return `
        <img
          class="team-logo"
          src="${escapeHtml(logo)}"
          alt="${escapeHtml(name)}"
          loading="lazy"
        >
      `;
    }

    return `<div class="team-logo-placeholder">⚽</div>`;
  }

  function renderMatchCard(partido, options) {
    const live = isLive(partido);
    const finished = isFinished(partido);

    const marcador =
      live || finished
        ? `${partido.golesLocal ?? 0} - ${partido.golesVisitante ?? 0}`
        : formatTime(partido.fecha);

    const estado =
      live
        ? `${partido.minuto || 0}'`
        : finished
          ? "FINAL"
          : formatTime(partido.fecha);

    const clase =
      live
        ? "match-card live-card"
        : finished
          ? "match-card finished-card"
          : "match-card";

    return `
      <div
        class="${clase}"
        onclick="openMatch(${Number(partido.id)}, ${live})"
      >
        <div class="match-card-top">
          <span>${escapeHtml(partido.liga || "Liga")}</span>
          <span class="${live ? "live-label" : ""}">
            ${escapeHtml(estado)}
          </span>
        </div>

        <div class="match-teams">

          <div class="team">
            ${renderTeamLogo(partido.logoLocal, partido.local)}
            <span>${escapeHtml(partido.local)}</span>
          </div>

          <div class="match-score">
            <strong>${escapeHtml(marcador)}</strong>
            ${
              live
                ? `<small>EN VIVO</small>`
                : finished
                  ? `<small>FINAL</small>`
                  : `<small>VS</small>`
            }
          </div>

          <div class="team">
            ${renderTeamLogo(partido.logoVisitante, partido.visitante)}
            <span>${escapeHtml(partido.visitante)}</span>
          </div>

        </div>
      </div>
    `;
  }

  function renderFeatured(partidos) {
    const container = document.getElementById("featuredMatch");

    if (!container) return;

    if (!partidos.length) {
      container.innerHTML = `
        <div class="empty-card">
          No hay partidos destacados para esta fecha.
        </div>
      `;
      return;
    }

    const partido = partidos[0];

    container.innerHTML = `
      <div
        class="featured-match"
        onclick="openMatch(${Number(partido.id)}, ${isLive(partido)})"
      >

        <div class="featured-league">
          ${escapeHtml(partido.liga || "Liga")}
        </div>

        <div class="featured-teams">

          <div>
            ${renderTeamLogo(partido.logoLocal, partido.local)}
            <strong>${escapeHtml(partido.local)}</strong>
          </div>

          <div class="featured-center">
            <span>
              ${
                isLive(partido)
                  ? `${partido.minuto || 0}'`
                  : formatTime(partido.fecha)
              }
            </span>

            <b>
              ${
                isLive(partido) || isFinished(partido)
                  ? `${partido.golesLocal ?? 0} - ${partido.golesVisitante ?? 0}`
                  : "VS"
              }
            </b>
          </div>

          <div>
            ${renderTeamLogo(partido.logoVisitante, partido.visitante)}
            <strong>${escapeHtml(partido.visitante)}</strong>
          </div>

        </div>

        <div class="featured-footer">
          VER ANÁLISIS →
        </div>

      </div>
    `;
  }

  function renderUpcoming(partidos) {
    const container = document.getElementById("upcomingMatches");

    if (!container) return;

    const upcoming = partidos.filter(function (partido) {
      return !isLive(partido) && !isFinished(partido);
    });

    if (!upcoming.length) {
      container.innerHTML = `
        <div class="empty-card">
          No hay próximos partidos.
        </div>
      `;
      return;
    }

    container.innerHTML = upcoming
      .slice(0, 12)
      .map(function (partido) {
        return renderMatchCard(partido);
      })
      .join("");
  }

  function renderLivePreview(partidos) {
    const container = document.getElementById("livePreview");

    if (!container) return;

    const live = partidos.filter(isLive);

    if (!live.length) {
      container.innerHTML = `
        <div class="empty-card">
          No hay partidos en vivo en este momento.
        </div>
      `;
      return;
    }

    container.innerHTML = live
      .slice(0, 8)
      .map(function (partido) {
        return renderMatchCard(partido);
      })
      .join("");
  }

  function renderFinishedPreview(partidos) {
    const container = document.getElementById("finishedPreview");

    if (!container) return;

    const finished = partidos.filter(isFinished);

    if (!finished.length) {
      container.innerHTML = `
        <div class="empty-card">
          No hay partidos finalizados.
        </div>
      `;
      return;
    }

    container.innerHTML = finished
      .slice(0, 8)
      .map(function (partido) {
        return renderMatchCard(partido);
      })
      .join("");
  }

  window.renderFinishedMatches = function () {
    const container = document.getElementById("finishedMatches");

    if (!container) return;

    const finished = fixturesCache.filter(isFinished);

    if (!finished.length) {
      container.innerHTML = `
        <div class="empty-card">
          No hay partidos finalizados para esta fecha.
        </div>
      `;
      return;
    }

    container.innerHTML = finished
      .map(function (partido) {
        return renderMatchCard(partido);
      })
      .join("");
  };

  async function loadFixtures(forceRefresh, dateChoice) {
    selectedDate = dateChoice || selectedDate || "today";

    const offset =
      selectedDate === "tomorrow"
        ? 1
        : 0;

    const fecha = getArgentinaDate(offset);

    const loadingElements = document.querySelectorAll(
      ".loading-fixtures"
    );

    loadingElements.forEach(function (element) {
      element.style.display = "block";
    });

    try {
      const response = await fetch(
        `/api/fixtures?date=${encodeURIComponent(fecha)}`,
        {
          cache: forceRefresh ? "no-store" : "default"
        }
      );

      if (!response.ok) {
        throw new Error(
          "API de fixtures respondió con estado " +
          response.status
        );
      }

      const data = await response.json();

      fixturesCache = Array.isArray(data.partidos)
        ? data.partidos
        : [];

      window.MatchIAFixtures = fixturesCache;

      renderFeatured(fixturesCache);
      renderUpcoming(fixturesCache);
      renderLivePreview(fixturesCache);
      renderFinishedPreview(fixturesCache);

      if (
        window.MatchIAUI &&
        window.MatchIAUI.getCurrentScreen() === "finished"
      ) {
        window.renderFinishedMatches();
      }

      console.log(
        "MatchIA: partidos cargados:",
        fixturesCache.length,
        "fecha:",
        fecha
      );

    } catch (error) {

      console.error(
        "MatchIA - Error cargando fixtures:",
        error
      );

      fixturesCache = [];

      const containers = [
        "featuredMatch",
        "upcomingMatches",
        "livePreview",
        "finishedPreview",
        "finishedMatches"
      ];

      containers.forEach(function (id) {
        const element = document.getElementById(id);

        if (element) {
          element.innerHTML = `
            <div class="empty-card">
              No se pudieron cargar los partidos.
              <br>
              <small>Revisá la conexión con la API.</small>
            </div>
          `;
        }
      });

    } finally {

      loadingElements.forEach(function (element) {
        element.style.display = "none";
      });
    }
  }

  window.loadFixtures = loadFixtures;

  window.getFixtures = function () {
    return fixturesCache;
  };

  window.doSearch = function () {
    const input = document.getElementById("searchInput");
    const container = document.getElementById("searchResults");

    if (!input || !container) return;

    const texto = input.value
      .trim()
      .toLowerCase();

    if (!texto) {
      container.innerHTML = `
        <div class="empty-card">
          Escribí un equipo para buscar.
        </div>
      `;
      return;
    }

    const resultados = fixturesCache.filter(function (partido) {

      const local = String(partido.local || "")
        .toLowerCase();

      const visitante = String(partido.visitante || "")
        .toLowerCase();

      const liga = String(partido.liga || "")
        .toLowerCase();

      return (
        local.includes(texto) ||
        visitante.includes(texto) ||
        liga.includes(texto)
      );
    });

    if (!resultados.length) {
      container.innerHTML = `
        <div class="empty-card">
          No encontramos partidos para "${escapeHtml(input.value)}".
        </div>
      `;
      return;
    }

    container.innerHTML = resultados
      .map(function (partido) {
        return renderMatchCard(partido);
      })
      .join("");
  };

  window.refreshFixtures = function () {
    loadFixtures(true, selectedDate);
  };

  document.addEventListener("DOMContentLoaded", function () {

    const searchInput =
      document.getElementById("searchInput");

    if (searchInput) {
      searchInput.addEventListener(
        "input",
        function () {
          window.doSearch();
        }
      );
    }

    // Actualiza partidos automáticamente.
    setInterval(function () {

      if (
        document.visibilityState === "visible"
      ) {
        loadFixtures(true, selectedDate);
      }

    }, 60000);

  });

})();
