    return drawPoints[0][1];
  }

  if (minute >= drawPoints[drawPoints.length - 1][0]) {
    return drawPoints[drawPoints.length - 1][1];
  }

  for (let i = 0; i < drawPoints.length - 1; i++) {
    const [m1, d1] = drawPoints[i];
    const [m2, d2] = drawPoints[i + 1];

    if (minute >= m1 && minute <= m2) {
      const ratio = (minute - m1) / (m2 - m1);
      return d1 + (d2 - d1) * ratio;
    }
  }

  return 34;
}

